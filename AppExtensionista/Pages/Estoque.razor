@page "/estoque"
@using AppExtensionista.Extensions
@using AppExtensionista.ViewModels
@using AppExtensionista.Services
@using AppExtensionista.Enums
@inject IEstoqueService EstoqueService
@inject IDescarteService DescarteService
@inject NavigationManager Navigation

<div class="mobile-container pb-60">
    <div class="header">
        <h2>(Logo) - Estoque</h2>
    </div>

    @if (viewModel != null)
    {
        <div class="stats-bar">
            <div class="stat-item">
                <span class="title">Cadastrados</span>
                <span class="value">@viewModel.TotalAlimentosCadastrados</span>
            </div>
            <div class="stat-item">
                <span class="title">Vencidos</span>
                <span class="value text-danger">@viewModel.TotalVencidos</span>
            </div>
            <div class="stat-item">
                <span class="title">Descartados</span>
                <span class="value">@viewModel.TotalDescartados</span>
            </div>
        </div>
    }

    <div class="search-box">
        <input type="text" placeholder="Digite um alimento ou marca" @bind="termoPesquisa" />
        <button class="btn-search" @onclick="Pesquisar">Pesquisar</button>
    </div>

    <div class="accordion-list">
        @if (viewModel == null)
        {
            <p>Carregando estoque...</p>
        }
        else if (!viewModel.Agrupamentos.Any())
        {
            <p>Nenhum item encontrado no estoque.</p>
        }
        else
        {
            @foreach (var grupo in viewModel.Agrupamentos)
            {
                bool isAberto = gruposAbertos.GetValueOrDefault(grupo.IdAlimento);

                <div class="accordion-item">
                    <div class="accordion-header" @onclick="() => ToggleGrupo(grupo.IdAlimento)">
                        <span>@(isAberto ? "▲" : "▼") @grupo.NomeAlimento - @grupo.QuantidadeTotalSomada @grupo.UnidadeMedidaSigla</span>
                    </div>

                    @if (isAberto)
                    {
                        <div class="accordion-body">
                            @foreach (var item in grupo.Itens)
                            {
                                <div class="item-row">
                                    <div class="item-info">
                                        <span>@item.DataValidade.ToString("dd/MM/yyyy") - @item.Quantidade @grupo.UnidadeMedidaSigla - @item.Marca</span>
                                    </div>
                                    <div class="item-actions">
                                        <button class="btn-icon" title="Editar" @onclick="() => EditarItem(item.IdEstoque)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="3"></circle>
                                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                            </svg>
                                        </button>
                                        <button class="btn-icon btn-danger" title="Excluir/Descartar" @onclick="() => AbrirModalDescarte(item)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    @if (exibirModalDescarte && descarteModel != null)
    {
        <div class="modal-overlay">
            <div class="modal-card">
                <h3>Motivo Descarte</h3>

                @if (!string.IsNullOrEmpty(mensagemErro))
                {
                    <div class="alert-error">
                        @mensagemErro
                    </div>
                }

                <div class="form-group">
                    <label>Quantidade a Descartar:</label>
                    <input type="number" step="0.01" class="form-control" @bind="descarteModel.QuantidadeDescartar" max="@quantidadeMaximaItem" />
                    <small>Disponível: @quantidadeMaximaItem @unidadeMedidaSigla </small>
                </div>

                <div class="form-group">
                    <label>Tipo descarte:</label>
                    <select class="form-control" @bind="descarteModel.TipoDescarte">
                        @foreach (DescarteEnum descarte in Enum.GetValues(typeof(DescarteEnum)))
                        {
                            <option value="@descarte">@descarte.ObterSigla()</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Descrição / Motivo:</label>
                    <textarea class="form-control" rows="3" placeholder="Informe o motivo do descarte..." @bind="descarteModel.DescricaoMotivo"></textarea>
                </div>

                <div class="modal-actions">
                    <button class="btn btn-dark" @onclick="ConfirmarDescarte">Salvar</button>
                    <button class="btn btn-light" @onclick="FecharModalDescarte">Voltar</button>
                </div>
            </div>
        </div>
    }
</div>

<AppExtensionista.Shared.BottomNav OnAbrirOpcoes="() => exibirOpcoes = true" />

@if (exibirOpcoes)
{
    <AppExtensionista.Shared.OpcoesModal OnFechar="() => exibirOpcoes = false" />
}

<style>
    .mobile-container {
        padding: 20px;
        font-family: sans-serif;
    }

    .pb-60 {
        padding-bottom: 70px;
    }

    .header h2 {
        margin-bottom: 16px;
        font-size: 22px;
        font-weight: bold;
    }

    .stats-bar {
        display: flex;
        justify-content: space-around;
        margin-bottom: 15px;
        background: #f5f5f5;
        padding: 10px;
        border-radius: 4px;
        border: 1px solid #e0e0e0;
    }

    .stat-item {
        text-align: center;
    }

        .stat-item .title {
            display: block;
            font-size: 11px;
            color: #666;
        }

        .stat-item .value {
            font-weight: bold;
            font-size: 16px;
        }

    .search-box {
        display: flex;
        gap: 6px;
        margin-bottom: 15px;
    }

        .search-box input {
            flex: 1;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

    .btn-search {
        background: #1976d2;
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
    }

    .accordion-item {
        border: 1px solid #000;
        border-radius: 4px;
        margin-bottom: 8px;
        overflow: hidden;
    }

    .accordion-header {
        background: #eee;
        padding: 10px;
        font-weight: bold;
        cursor: pointer;
        font-size: 14px;
    }

    .accordion-body {
        padding: 8px;
        background: #fff;
    }

    .item-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #eee;
        padding: 8px 0;
        font-size: 12px;
    }

    .item-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-icon {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #333;
        border-radius: 4px;
        transition: background 0.2s;
    }

        .btn-icon:hover {
            background: #f0f0f0;
        }

    .btn-danger {
        color: #d32f2f;
    }

        .btn-danger:hover {
            background: #ffebee;
        }

    .alert-error {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
        padding: 8px 12px;
        border-radius: 4px;
        font-size: 12px;
        margin-bottom: 12px;
        text-align: center;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 2000;
    }

    .modal-card {
        background: #1e1e1e;
        color: #fff;
        padding: 20px;
        border-radius: 8px;
        width: 100%;
        max-width: 320px;
        text-align: left;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

        .modal-card h3 {
            margin-top: 0;
            border-bottom: 1px solid #444;
            padding-bottom: 10px;
            font-size: 18px;
            margin-bottom: 12px;
        }

    .form-group {
        margin-bottom: 12px;
    }

        .form-group label {
            display: block;
            font-size: 12px;
            margin-bottom: 4px;
            color: #ccc;
        }

    .form-control {
        width: 100%;
        padding: 8px;
        border-radius: 4px;
        border: 1px solid #444;
        background: #2a2a2a;
        color: #fff;
        box-sizing: border-box;
        font-family: inherit;
    }

        .form-control:focus {
            outline: none;
            border-color: #888;
        }

    .modal-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 18px;
        gap: 10px;
    }

        .modal-actions .btn {
            flex: 1;
        }

    .btn {
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        border: none;
    }

    .btn-dark {
        background: #333;
        color: #fff;
        border: 1px solid #555;
    }

    .btn-light {
        background: #e0e0e0;
        color: #000;
    }
</style>

@code {
    private int idUsuarioLogado = 1; // Tem que mudar depois para pegar o id do usuário atual

    private string termoPesquisa = "";
    private bool exibirOpcoes = false;
    private bool exibirModalDescarte = false;
    private string mensagemErro = "";

    private EstoqueIndexViewModel? viewModel;
    private Dictionary<int, bool> gruposAbertos = new();

    private RegistrarDescarteModalViewModel? descarteModel;
    private decimal quantidadeMaximaItem = 0;
    private string? unidadeMedidaSigla = "";

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        mensagemErro = "";
        viewModel = await EstoqueService.ObterEstoqueAgrupadoAsync(termoPesquisa);
    }

    private async Task Pesquisar()
    {
        mensagemErro = "";
        await CarregarDados();
    }

    private void ToggleGrupo(int idAlimento)
    {
        bool currentState = gruposAbertos.GetValueOrDefault(idAlimento);
        gruposAbertos[idAlimento] = !currentState;
    }

    private void EditarItem(int idEstoque)
    {
        Navigation.NavigateTo($"/criar-alimento/{idEstoque}");
    }

    private void AbrirModalDescarte(EstoqueItemDetalheViewModel item)
    {
        mensagemErro = "";
        quantidadeMaximaItem = item.Quantidade;
        descarteModel = new RegistrarDescarteModalViewModel
        {
            IdEstoque = item.IdEstoque,
            QuantidadeDescartar = item.Quantidade, // Por padrão, sugere descartar/consumir tudo
            TipoDescarte = DescarteEnum.Consumo 
        };
        exibirModalDescarte = true;
        unidadeMedidaSigla = item.UnidadeMedidaSigla;
    }

    private void FecharModalDescarte()
    {
        mensagemErro = "";
        exibirModalDescarte = false;
        descarteModel = null;
    }

    private async Task ConfirmarDescarte()
    {
        try
        {
            if (descarteModel != null)
            {
                await DescarteService.RegistrarDescarteAsync(descarteModel, idUsuarioLogado);
                exibirModalDescarte = false;

                // Recarrega os dados após descartar/consumir
                await CarregarDados();
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Ocorreu um erro: {ex.Message}";
        }

        
    }
}