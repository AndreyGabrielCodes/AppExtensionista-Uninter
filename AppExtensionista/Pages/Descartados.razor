@page "/descartados"
@using AppExtensionista.ViewModels
@using AppExtensionista.Services
@inject IDescarteService DescarteService

<div class="mobile-container pb-60">
    <div class="header">
        <h2>(Logo) - Descartados</h2>
        <small class="subtitle">Descarte/Consumo de produtos</small>
    </div>

    @if (viewModel != null)
    {
        <div class="total-box">
            <span>Total Registros Descartados/Consumidos</span>
            <strong>@viewModel.TotalDescartadosConsumidos</strong>
        </div>
    }

    <div class="search-box">
        <input type="text" placeholder="Digite um alimento ou marca" @bind="termoPesquisa" />
        <button class="btn-search" @onclick="Pesquisar">Pesquisar</button>
    </div>

    <div class="accordion-list">
        @if (viewModel == null)
        {
            <p>Carregando descartes...</p>
        }
        else if (!viewModel.Agrupamentos.Any())
        {
            <p>Nenhum item descartado encontrado.</p>
        }
        else
        {
            @foreach (var grupo in viewModel.Agrupamentos)
            {
                bool isAberto = gruposAbertos.GetValueOrDefault(grupo.NomeAlimento);

                <div class="accordion-item">
                    <div class="accordion-header" @onclick="() => ToggleGrupo(grupo.NomeAlimento)">
                        <span>@(isAberto ? "▲" : "▼") @grupo.NomeAlimento - @grupo.QuantidadeTotalDescartada @grupo.UnidadeMedidaSigla</span>
                    </div>

                    @if (isAberto)
                    {
                        <div class="accordion-body">
                            @foreach (var item in grupo.Itens)
                            {
                                <div class="item-row" @onclick="() => ExibirMotivo(item.IdRegistroDescarte)">
                                    <span>@item.DataDescarte.ToString("dd/MM/yyyy") - @item.Quantidade @grupo.UnidadeMedidaSigla - @item.Marca - @item.TipoDescarte</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    @if (detalheMotivo != null)
    {
        <div class="modal-overlay">
            <div class="modal-card">
                <h3>Motivo Descarte</h3>
                <p><strong>Tipo descarte:</strong> @detalheMotivo.TipoDescarte</p>
                <div class="desc-box">
                    <label>Descrição:</label>
                    <p>@(string.IsNullOrWhiteSpace(detalheMotivo.DescricaoMotivo) ? "Nenhuma descrição informada." : detalheMotivo.DescricaoMotivo)</p>
                </div>
                <div class="modal-actions align-right">
                    <button class="btn btn-light" @onclick="() => detalheMotivo = null">Voltar</button>
                </div>
            </div>
        </div>
    }
</div>

<AppExtensionista.Shared.BottomNav OnAbrirOpcoes="() => exibirOpcoes = true" />

@if (exibirOpcoes)
{
    <AppExtensionista.Shared.OpcoesModal OnFechar="() => exibirOpcoes = false" />
}

<style>
    .mobile-container {
        padding: 20px;
        font-family: sans-serif;
    }

    .pb-60 {
        padding-bottom: 70px;
    }

    .header h2 {
        margin-bottom: 4px;
        font-size: 22px;
        font-weight: bold;
    }

    .subtitle {
        display: block;
        color: #666;
        margin-bottom: 16px;
        font-size: 13px;
    }

    .total-box {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        margin-bottom: 12px;
        background: #f5f5f5;
        padding: 10px;
        border-radius: 4px;
        border: 1px solid #e0e0e0;
    }

    .search-box {
        display: flex;
        gap: 6px;
        margin-bottom: 15px;
    }

        .search-box input {
            flex: 1;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

    .btn-search {
        background: #1976d2;
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
    }

    .accordion-item {
        border: 1px solid #000;
        border-radius: 4px;
        margin-bottom: 8px;
        overflow: hidden;
    }

    .accordion-header {
        background: #eee;
        padding: 10px;
        font-weight: bold;
        cursor: pointer;
        font-size: 14px;
    }

    .accordion-body {
        padding: 8px;
        background: #fff;
    }

    .item-row {
        cursor: pointer;
        padding: 8px 0;
        border-bottom: 1px solid #eee;
        font-size: 12px;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 2000;
    }

    .modal-card {
        background: #1e1e1e;
        color: #fff;
        padding: 20px;
        border-radius: 8px;
        width: 100%;
        max-width: 320px;
        text-align: left;
    }

        .modal-card h3 {
            margin-top: 0;
            border-bottom: 1px solid #444;
            padding-bottom: 8px;
        }

    .desc-box {
        background: #333;
        padding: 10px;
        border-radius: 4px;
        margin: 10px 0;
        font-size: 13px;
    }

    .modal-actions {
        display: flex;
        margin-top: 15px;
    }

    .align-right {
        justify-content: flex-end;
    }

    .btn {
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        border: none;
    }

    .btn-light {
        background: #ccc;
        color: #000;
    }
</style>

@code {
    private string termoPesquisa = "";
    private bool exibirOpcoes = false;

    private DescartadosIndexViewModel? viewModel;
    private Dictionary<string, bool> gruposAbertos = new();
    private MotivoDescarteModalViewModel? detalheMotivo;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        viewModel = await DescarteService.ObterDescartadosAgrupadosAsync(termoPesquisa);
    }

    private async Task Pesquisar()
    {
        await CarregarDados();
    }

    private void ToggleGrupo(string nomeGrupo)
    {
        bool currentState = gruposAbertos.GetValueOrDefault(nomeGrupo);
        gruposAbertos[nomeGrupo] = !currentState;
    }

    private async Task ExibirMotivo(int idRegistroDescarte)
    {
        detalheMotivo = await DescarteService.ObterMotivoDescarteAsync(idRegistroDescarte);
    }
}