@page "/"
@inject NavigationManager Navigation

<div class="mobile-container login-page">
    <div class="logo-area">
        <h1>Logo</h1>
        <p>Sistema de controle de vencimento de alimentos</p>
    </div>

    <div class="actions">
        <button class="btn btn-primary btn-block" @onclick="AbrirModalLogin">Logar</button>
        <button class="btn btn-outline btn-block" @onclick="AbrirModalCriar">Criar Usuario</button>
    </div>

    @if (modalAtual != ModalTipo.Nenhum)
    {
        <div class="modal-overlay">
            <div class="modal-card">
                <h3>Usuário</h3>

                <div class="form-group">
                    <label>Login:</label>
                    <input type="text" class="form-control" @bind="usuarioForm.Login" />
                </div>

                @if (modalAtual == ModalTipo.CriarUsuario)
                {
                    <div class="form-group">
                        <label>Nome:</label>
                        <input type="text" class="form-control" @bind="usuarioForm.Nome" />
                    </div>
                }

                <div class="form-group">
                    <label>Senha:</label>
                    <input type="password" class="form-control" @bind="usuarioForm.Senha" />
                </div>

                @if (modalAtual == ModalTipo.CriarUsuario)
                {
                    <div class="form-group">
                        <label>Dias Alerta Vencimento:</label>
                        <input type="number" class="form-control" @bind="usuarioForm.DiasAlerta" />
                    </div>
                }

                <div class="modal-actions">
                    <button class="btn btn-dark" @onclick="ConfirmarAcao">
                        @(modalAtual == ModalTipo.Login ? "Entrar" : "Salvar")
                    </button>
                    <button class="btn btn-light" @onclick="FecharModal">Voltar</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private enum ModalTipo { Nenhum, Login, CriarUsuario }
    private ModalTipo modalAtual = ModalTipo.Nenhum;
    private UsuarioModelForm usuarioForm = new();

    private void AbrirModalLogin()
    {
        usuarioForm = new UsuarioModelForm();
        modalAtual = ModalTipo.Login;
    }

    private void AbrirModalCriar()
    {
        usuarioForm = new UsuarioModelForm();
        modalAtual = ModalTipo.CriarUsuario;
    }

    private void FecharModal()
    {
        modalAtual = ModalTipo.Nenhum;
    }

    private void ConfirmarAcao()
    {
        modalAtual = ModalTipo.Nenhum;
        Navigation.NavigateTo("/estoque");
    }

    public class UsuarioModelForm
    {
        public string Login { get; set; } = "";
        public string Nome { get; set; } = "";
        public string Senha { get; set; } = "";
        public int DiasAlerta { get; set; } = 7;
    }
}

<style>
    .mobile-container {
        padding: 20px;
        text-align: center;
        font-family: sans-serif;
    }

    .login-page {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 85vh;
    }

    .logo-area h1 {
        font-size: 38px;
        margin-bottom: 8px;
        font-weight: bold;
    }

    .logo-area p {
        font-size: 14px;
        color: #555;
        margin-bottom: 40px;
    }

    .btn {
        padding: 12px;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        border: 1px solid transparent;
        text-align: center;
    }

    .btn-block {
        width: 100%;
        display: block;
        margin-bottom: 12px;
    }

    .btn-primary {
        background: #000;
        color: #fff;
    }

    .btn-outline {
        background: transparent;
        border-color: #000;
        color: #000;
    }

    .btn-dark {
        background: #333;
        color: #fff;
        border: 1px solid #555;
    }

    .btn-light {
        background: #e0e0e0;
        color: #000;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 2000;
    }

    .modal-card {
        background: #1e1e1e;
        color: #fff;
        padding: 20px;
        border-radius: 8px;
        width: 100%;
        max-width: 320px;
        text-align: left;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

        .modal-card h3 {
            margin-top: 0;
            border-bottom: 1px solid #444;
            padding-bottom: 10px;
            font-size: 18px;
        }

    .form-group {
        margin-bottom: 12px;
    }

        .form-group label {
            display: block;
            font-size: 12px;
            margin-bottom: 4px;
            color: #ccc;
        }

    .form-control {
        width: 100%;
        padding: 10px;
        border-radius: 4px;
        border: 1px solid #444;
        background: #2a2a2a;
        color: #fff;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #888;
        }

    .modal-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
        gap: 10px;
    }

        .modal-actions .btn {
            flex: 1;
        }
</style>