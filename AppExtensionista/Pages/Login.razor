@page "/"
@using AppExtensionista.ViewModels
@using AppExtensionista.Services
@inject IUsuarioService UsuarioService
@inject NavigationManager Navigation

<div class="mobile-container login-page">
    <div class="logo-area">
        <h1>Logo</h1>
        <p>Sistema de controle de vencimento de alimentos</p>
    </div>

    <div class="actions">
        <button class="btn btn-primary btn-block" @onclick="AbrirModalLogin">Logar</button>
        <button class="btn btn-outline btn-block" @onclick="AbrirModalCriar">Criar Usuário</button>
    </div>

    @if (modalAtual != ModalTipo.Nenhum)
    {
        <div class="modal-overlay">
            <div class="modal-card">
                <h3>@(modalAtual == ModalTipo.Login ? "Entrar no Sistema" : "Novo Usuário")</h3>

                @if (!string.IsNullOrEmpty(mensagemErro))
                {
                    <div class="alert-error">
                        @mensagemErro
                    </div>
                }

                <div class="form-group">
                    <label>Login:</label>
                    <input type="text" class="form-control" placeholder="Digite seu login" @bind="usuarioForm.Login" />
                </div>

                @if (modalAtual == ModalTipo.CriarUsuario)
                {
                    <div class="form-group">
                        <label>Nome:</label>
                        <input type="text" class="form-control" placeholder="Digite seu nome completo" @bind="usuarioForm.Nome" />
                    </div>
                }

                <div class="form-group">
                    <label>Senha:</label>
                    <input type="password" class="form-control" placeholder="Digite sua senha" @bind="usuarioForm.Senha" />
                </div>

                @if (modalAtual == ModalTipo.CriarUsuario)
                {
                    <div class="form-group">
                        <label>Dias Alerta Vencimento:</label>
                        <input type="number" class="form-control" min="1" max="90" @bind="usuarioForm.DiasAlertaVencimento" />
                    </div>
                }

                <div class="modal-actions">
                    <button class="btn btn-dark" @onclick="ConfirmarAcao" disabled="@carregando">
                        @(carregando ? "Aguarde..." : (modalAtual == ModalTipo.Login ? "Entrar" : "Salvar"))
                    </button>
                    <button class="btn btn-light" @onclick="FecharModal" disabled="@carregando">Voltar</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private enum ModalTipo { Nenhum, Login, CriarUsuario }
    private ModalTipo modalAtual = ModalTipo.Nenhum;

    private UsuarioModalViewModel usuarioForm = new();
    private string mensagemErro = "";
    private bool carregando = false;

    private void AbrirModalLogin()
    {
        usuarioForm = new UsuarioModalViewModel();
        mensagemErro = "";
        modalAtual = ModalTipo.Login;
    }

    private void AbrirModalCriar()
    {
        usuarioForm = new UsuarioModalViewModel();
        mensagemErro = "";
        modalAtual = ModalTipo.CriarUsuario;
    }

    private void FecharModal()
    {
        if (carregando) return;
        modalAtual = ModalTipo.Nenhum;
        mensagemErro = "";
    }

    private async Task ConfirmarAcao()
    {
        mensagemErro = "";

        // Validações básicas de tela
        if (string.IsNullOrWhiteSpace(usuarioForm.Login) || string.IsNullOrWhiteSpace(usuarioForm.Senha))
        {
            mensagemErro = "Preencha o login e a senha.";
            return;
        }

        if (modalAtual == ModalTipo.CriarUsuario && string.IsNullOrWhiteSpace(usuarioForm.Nome))
        {
            mensagemErro = "Preencha o seu nome.";
            return;
        }

        carregando = true;

        try
        {
            if (modalAtual == ModalTipo.Login)
            {
                var loginSucesso = await UsuarioService.AutenticarAsync(usuarioForm.Login, usuarioForm.Senha);

                if (loginSucesso != null)
                {
                    modalAtual = ModalTipo.Nenhum;
                    Navigation.NavigateTo("/estoque");
                }
                else
                {
                    mensagemErro = "Login ou senha inválidos.";
                }
            }
            else if (modalAtual == ModalTipo.CriarUsuario)
            {
                var usuarioCriado = await UsuarioService.CriarUsuarioAsync(usuarioForm);

                if (usuarioCriado != null)
                {
                    modalAtual = ModalTipo.Nenhum;
                    Navigation.NavigateTo("/estoque");
                }
                else
                {
                    mensagemErro = "Não foi possível criar o usuário. Tente outro login.";
                }
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Ocorreu um erro: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }
}

<style>
    .mobile-container {
        padding: 20px;
        text-align: center;
        font-family: sans-serif;
    }

    .login-page {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 85vh;
    }

    .logo-area h1 {
        font-size: 38px;
        margin-bottom: 8px;
        font-weight: bold;
    }

    .logo-area p {
        font-size: 14px;
        color: #555;
        margin-bottom: 40px;
    }

    .btn {
        padding: 12px;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        border: 1px solid transparent;
        text-align: center;
        transition: opacity 0.2s;
    }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .btn-block {
        width: 100%;
        display: block;
        margin-bottom: 12px;
    }

    .btn-primary {
        background: #000;
        color: #fff;
    }

    .btn-outline {
        background: transparent;
        border-color: #000;
        color: #000;
    }

    .btn-dark {
        background: #333;
        color: #fff;
        border: 1px solid #555;
    }

    .btn-light {
        background: #e0e0e0;
        color: #000;
    }

    .alert-error {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
        padding: 8px 12px;
        border-radius: 4px;
        font-size: 12px;
        margin-bottom: 12px;
        text-align: center;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 2000;
    }

    .modal-card {
        background: #1e1e1e;
        color: #fff;
        padding: 20px;
        border-radius: 8px;
        width: 100%;
        max-width: 320px;
        text-align: left;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

        .modal-card h3 {
            margin-top: 0;
            border-bottom: 1px solid #444;
            padding-bottom: 10px;
            font-size: 18px;
        }

    .form-group {
        margin-bottom: 12px;
    }

        .form-group label {
            display: block;
            font-size: 12px;
            margin-bottom: 4px;
            color: #ccc;
        }

    .form-control {
        width: 100%;
        padding: 10px;
        border-radius: 4px;
        border: 1px solid #444;
        background: #2a2a2a;
        color: #fff;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #888;
        }

    .modal-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
        gap: 10px;
    }

        .modal-actions .btn {
            flex: 1;
        }
</style>