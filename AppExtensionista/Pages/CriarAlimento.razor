@page "/criar-alimento"
@page "/criar-alimento/{IdEstoque:int}"
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using AppExtensionista.Extensions
@using AppExtensionista.ViewModels
@using AppExtensionista.Services
@using AppExtensionista.Enums
@inject IEstoqueService EstoqueService
@inject NavigationManager Navigation

<div class="mobile-container pb-60">
    <div class="header">
        <h2>(Logo) - @(IdEstoque.HasValue ? "Editar Alimento" : "Cadastrar Alimento")</h2>
    </div>

    <div class="form-container">
        <div class="form-group">
            <label>Nome do Alimento:</label>
            <input type="text" class="form-control" placeholder="Ex: Arroz, Feijão..." @bind="model.NomeAlimento" disabled="@model.IsEdicao" />
            @if (model.IsEdicao)
            {
                <small>Não é possível alterar o nome na edição de estoque.</small>
            }
        </div>

        <div class="form-group">
            <label>Marca:</label>
            <input type="text" class="form-control" placeholder="Ex: Camil, Tio João..." @bind="model.Marca" />
        </div>

        <div class="form-row">
            <div class="form-group col">
                <label>Quantidade:</label>
                <input type="number" step="0.01" class="form-control" placeholder="0" @bind="model.Quantidade" />
            </div>

            <div class="form-group col">
                <label>Unidade de Medida:</label>
                <select class="form-control" @bind="model.UnidadeMedida" disabled="@model.IsEdicao">
                    @foreach (UnidadeMedidaEnum unidade in Enum.GetValues(typeof(UnidadeMedidaEnum)))
                    {
                        <option value="@unidade">@unidade.ObterSigla() - @unidade.ToString()</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>Data de Vencimento:</label>
            <input type="date" class="form-control" @bind="model.DataValidade" disabled="@model.IsEdicao" />
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" @onclick="Salvar" disabled="@salvando">
                @(salvando ? "Salvando..." : "Salvar")
            </button>
            <button class="btn btn-secondary" @onclick="Cancelar" disabled="@salvando">Cancelar</button>
        </div>
    </div>
</div>

<AppExtensionista.Shared.BottomNav OnAbrirOpcoes="() => exibirOpcoes = true" />

@if (exibirOpcoes)
{
    <AppExtensionista.Shared.OpcoesModal OnFechar="() => exibirOpcoes = false" />
}

<style>
    .mobile-container {
        padding: 20px;
        font-family: sans-serif;
    }

    .pb-60 {
        padding-bottom: 70px;
    }

    .header h2 {
        margin-bottom: 20px;
        font-size: 22px;
        font-weight: bold;
    }

    .form-container {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .form-row {
        display: flex;
        gap: 10px;
    }

    .col {
        flex: 1;
    }

    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 4px;
        color: #333;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-sizing: border-box;
        font-size: 14px;
        background: #fff;
    }

        .form-control:focus {
            outline: none;
            border-color: #1976d2;
        }

        .form-control:disabled {
            background: #f0f0f0;
            color: #888;
        }

    small {
        font-size: 11px;
        color: #888;
        display: block;
        margin-top: 4px;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .btn {
        flex: 1;
        padding: 12px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        border: none;
        font-size: 14px;
    }

    .btn-primary {
        background: #1976d2;
        color: #fff;
    }

    .btn-secondary {
        background: #e0e0e0;
        color: #333;
    }
</style>

@code {
    [Parameter]
    public int? IdEstoque { get; set; }

    private int idUsuarioLogado = 1; // Tem que mudar depois para pegar o id do usuário atual

    private bool exibirOpcoes = false;
    private bool salvando = false;

    private AlimentoCadastroViewModel model = new()
    {
        DataValidade = DateTime.Today.AddDays(1), //Amanhã como dia padrão
        UnidadeMedida = UnidadeMedidaEnum.Grama //Unidade padrão que vai aparecer na tela
    };

    protected override async Task OnInitializedAsync()
    {
        if (IdEstoque.HasValue)
        {
            var estoqueExistente = await EstoqueService.ObterParaEdicaoAsync(IdEstoque.Value);
            if (estoqueExistente != null)
            {
                model = estoqueExistente;
            }
        }
    }

    private async Task Salvar()
    {
        if (string.IsNullOrWhiteSpace(model.NomeAlimento)) return;

        salvando = true;

        try
        {
            await EstoqueService.SalvarOuAtualizarItemEstoqueAsync(model, idUsuarioLogado);
            Navigation.NavigateTo("/estoque");
        }
        finally
        {
            salvando = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/estoque");
    }
}