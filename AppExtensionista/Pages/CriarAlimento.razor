@page "/criar-alimento"
@page "/criar-alimento/{IdEstoque:int}"
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using AppExtensionista.Extensions
@using AppExtensionista.ViewModels
@using AppExtensionista.Services
@using AppExtensionista.Enums
@inject IAlimentoService AlimentoService
@inject IEstoqueService EstoqueService
@inject NavigationManager Navigation

<AppExtensionista.Shared.TopNav Titulo="Estoque" Descricao="@(IdEstoque.HasValue ? "Edição de Alimento já cadastrado no estoque" : "Cadastrar novo Alimento no estoque")" />

<AppExtensionista.Shared.GuiaArmazenamentoModal @ref="guiaModalRef" OnGuiaSalva="FinalizarProcessoSalvar" />

<div class="mobile-container pb-60">

    <div class="form-container">

        @if (!model.IsEdicao)
        {
            <div class="form-group">
                <label>Alimentos Já Cadastrados:</label>
                <select class="form-control" @onchange="OnSelecionarAlimentoExistente">
                    <option value="">Selecione um alimento existente (Opcional)</option>
                    @foreach (var alimento in model.AlimentosExistentesOptions)
                    {
                        <option value="@alimento.IdAlimento">@alimento.Nome (@alimento.UnidadeMedida.ObterSigla())</option>
                    }
                </select>
                <small>Preenche automaticamente o nome e a unidade de medida.</small>
            </div>
        }

        <div class="form-group">
            <label>Nome do Alimento:</label>
            <input type="text" class="form-control" placeholder="Ex: Arroz, Feijão..." @bind="model.NomeAlimento" disabled="@model.IsEdicao" />
            @if (model.IsEdicao)
            {
                <small>Não é possível alterar o nome na edição de estoque.</small>
            }
        </div>

        <div class="form-group">
            <label>Marca:</label>
            <input type="text" class="form-control" placeholder="Ex: Camil, Tio João..." @bind="model.Marca" />
        </div>

        <div class="form-row">
            <div class="form-group col">
                <label>Quantidade:</label>
                <input type="number" step="0.01" class="form-control" placeholder="0" @bind="model.Quantidade" />
            </div>

            <div class="form-group col">
                <label>Unidade de Medida:</label>
                <select class="form-control" @bind="model.UnidadeMedida" disabled="@model.IsEdicao">
                    @foreach (UnidadeMedidaEnum unidade in Enum.GetValues(typeof(UnidadeMedidaEnum)))
                    {
                        <option value="@unidade">@unidade.ObterSigla() - @unidade.ToString()</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>Data de Vencimento:</label>
            <input type="date" class="form-control" @bind="model.DataValidade" disabled="@model.IsEdicao" />
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" @onclick="IniciarSalvar" disabled="@salvando">
                @(salvando ? "Salvando..." : "Salvar")
            </button>
            <button class="btn btn-secondary" @onclick="Cancelar" disabled="@salvando">Cancelar</button>
        </div>
    </div>
</div>

<AppExtensionista.Shared.BottomNav OnAbrirOpcoes="() => exibirOpcoes = true" />

@if (exibirOpcoes)
{
    <AppExtensionista.Shared.OpcoesModal OnFechar="() => exibirOpcoes = false" />
}

<style>
    .mobile-container {
        padding: 20px;
        font-family: sans-serif;
    }

    .pb-60 {
        padding-bottom: 70px;
    }

    .form-container {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .form-row {
        display: flex;
        gap: 10px;
    }

    .col {
        flex: 1;
    }

    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 4px;
        color: #333;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-sizing: border-box;
        font-size: 14px;
        background: #fff;
    }

    .form-control:focus {
        outline: none;
        border-color: #1976d2;
    }

    .form-control:disabled {
        background: #f0f0f0;
        color: #888;
    }

    small {
        font-size: 11px;
        color: #888;
        display: block;
        margin-top: 4px;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .btn {
        flex: 1;
        padding: 12px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        border: none;
        font-size: 14px;
    }

    .btn-primary {
        background: #1976d2;
        color: #fff;
    }

    .btn-secondary {
        background: #e0e0e0;
        color: #333;
    }
</style>

@code {
    [Parameter]
    public int? IdEstoque { get; set; }
    private bool exibirOpcoes = false;
    private bool salvando = false;
    private AppExtensionista.Shared.GuiaArmazenamentoModal? guiaModalRef;

    private AlimentoCadastroViewModel model = new()
    {
        DataValidade = DateTime.Today.AddDays(1), //Amanhã como dia padrão
        UnidadeMedida = UnidadeMedidaEnum.Grama //Unidade padrão que vai aparecer na tela
    };

    protected override async Task OnInitializedAsync()
    {
        model.AlimentosExistentesOptions = await AlimentoService.ObterAlimentosExistentesOptionsAsync();

        if (IdEstoque.HasValue)
        {
            var estoqueExistente = await EstoqueService.ObterParaEdicaoAsync(IdEstoque.Value);
            if (estoqueExistente != null)
            {
                model = estoqueExistente;
                model.AlimentosExistentesOptions = await AlimentoService.ObterAlimentosExistentesOptionsAsync();
            }
        }
    }

    private void OnSelecionarAlimentoExistente(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idAlimentoSelecionado) && idAlimentoSelecionado > 0)
        {
            var alimentoEscolhido = model.AlimentosExistentesOptions
                .FirstOrDefault(a => a.IdAlimento == idAlimentoSelecionado);

            if (alimentoEscolhido != null)
            {
                model.IdAlimentoSelecionado = alimentoEscolhido.IdAlimento;
                model.NomeAlimento = alimentoEscolhido.Nome;
                model.UnidadeMedida = alimentoEscolhido.UnidadeMedida;
            }
        }
        else
        {
            model.IdAlimentoSelecionado = null;
        }
    }

    private async Task IniciarSalvar()
    {
        if (string.IsNullOrWhiteSpace(model.NomeAlimento))
        {
            return;
        }

        salvando = true;

        try
        {
            await EstoqueService.SalvarOuAtualizarItemEstoqueAsync(model);

            // Busca o IdAlimento gerado ou selecionado
            int idAlimentoAlvo = model.IdAlimentoSelecionado ?? 0;

            if (idAlimentoAlvo == 0)
            {
                var listaOpts = await AlimentoService.ObterAlimentosExistentesOptionsAsync();
                var recemCriado = listaOpts.FirstOrDefault(a => a.Nome.Equals(model.NomeAlimento, StringComparison.OrdinalIgnoreCase));
                if (recemCriado != null)
                {
                    idAlimentoAlvo = recemCriado.IdAlimento;
                }
            }

            if (idAlimentoAlvo > 0 && guiaModalRef != null)
            {
                await guiaModalRef.AbrirModalParaAlimento(idAlimentoAlvo, model.NomeAlimento);
                return; // O fluxo será concluído após o usuário fechar/salvar a guia 
            }

            // Finaliza direto se por algum motivo não achar o ID do alimento
            Navigation.NavigateTo("/estoque");
        }
        catch
        {
            salvando = false;
        }
    }

    private void FinalizarProcessoSalvar()
    {
        salvando = false;
        Navigation.NavigateTo("/estoque");
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/estoque");
    }
}