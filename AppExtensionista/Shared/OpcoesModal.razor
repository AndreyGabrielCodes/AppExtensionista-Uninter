@inject NavigationManager Navigation

<div class="modal-overlay">
    <div class="modal-card opcoes-card">
        <h3>Opções</h3>

        <button class="menu-btn" @onclick="Sair">
            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Sair</span>
        </button>

        <button class="menu-btn" @onclick="ToggleAviso">
            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Alterar número de dias de aviso de vencimento</span>
        </button>

        @if (exibindoAvisoVencimento)
        {
            <div class="input-inline">
                <input type="number" class="form-control" @bind="diasAlerta" min="1" />
                <button class="btn btn-dark" @onclick="SalvarDias">Salvar</button>
            </div>
        }

        <div class="modal-actions align-right">
            <button class="btn btn-light" @onclick="OnFechar">Voltar</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnFechar { get; set; }

    private bool exibindoAvisoVencimento = false;
    private int diasAlerta = 7;

    private void ToggleAviso()
    {
        exibindoAvisoVencimento = !exibindoAvisoVencimento;
    }

    private void Sair()
    {
        Navigation.NavigateTo("/");
    }

    private void SalvarDias()
    {
        exibindoAvisoVencimento = false;
    }
}

<style>
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 2000;
    }

    .opcoes-card {
        background: #1e1e1e;
        color: #fff;
        padding: 20px;
        border-radius: 8px;
        width: 100%;
        max-width: 320px;
        text-align: left;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

        .opcoes-card h3 {
            margin-top: 0;
            border-bottom: 1px solid #444;
            padding-bottom: 10px;
            font-size: 18px;
            margin-bottom: 10px;
        }

    .menu-btn {
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        color: #fff;
        padding: 12px 0;
        font-size: 14px;
        border-bottom: 1px solid #333;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .menu-btn:hover {
            color: #ccc;
        }

    .btn-icon {
        flex-shrink: 0;
        color: #fff;
    }

    .input-inline {
        display: flex;
        gap: 8px;
        margin-top: 12px;
        margin-bottom: 8px;
    }

    .form-control {
        flex: 1;
        padding: 8px;
        border-radius: 4px;
        border: 1px solid #444;
        background: #2a2a2a;
        color: #fff;
        box-sizing: border-box;
    }

    .modal-actions {
        display: flex;
        margin-top: 20px;
    }

    .align-right {
        justify-content: flex-end;
    }

    .btn {
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        border: none;
    }

    .btn-dark {
        background: #333;
        color: #fff;
        border: 1px solid #555;
    }

    .btn-light {
        background: #e0e0e0;
        color: #000;
    }
</style>