@using AppExtensionista.Models
@using AppExtensionista.Services
@inject NavigationManager Navigation
@inject ISettingsService SettingsService

<div class="modal-overlay">
    <div class="modal-card opcoes-card">
        <h3>Opções do Dispositivo</h3>

        @if (!string.IsNullOrEmpty(mensagemErro))
        {
            <div class="alert-error">@mensagemErro</div>
        }

        <button class="menu-btn" @onclick="ToggleAviso">
            <svg class="btn-icon-claro" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
                <circle cx="8" cy="14" r="1" fill="currentColor"></circle>
                <circle cx="12" cy="14" r="1" fill="currentColor"></circle>
                <circle cx="16" cy="14" r="1" fill="currentColor"></circle>
            </svg>
            <span>Alterar dias de aviso de vencimento</span>
        </button>

        @if (exibindoAvisoVencimento)
        {
            <p class="alerta-sub">Altera quantos dias antes do vencimento o alerta será exibido</p>
            <div class="input-inline">
                <input type="number" class="form-control-input-opcoes" @bind="diasAlerta" min="1" />
            </div>
        }

        <button class="menu-btn" @onclick="ToggleHistorico">
            <svg class="btn-icon-claro" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
            <span>Alterar dias de histórico de descartados</span>
        </button>

        @if (exibindoHistoricoDescartados)
        {
            <p class="alerta-sub">Mostra os descartados/consumidos dos últimos X dias</p>
            <div class="input-inline">
                <input type="number" class="form-control-input-opcoes" @bind="diasHistorico" min="1" />
            </div>
        }

        <div class="modal-actions-opcoes">
            <button class="btn-opcoes btn-primary-opcoes" @onclick="SalvarOpcoes">Salvar Opções</button>
            <button class="btn-opcoes btn-secondary-opcoes" @onclick="OnFechar">Voltar</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnFechar { get; set; }

    private string mensagemErro = "";
    private bool exibindoAvisoVencimento = false;
    private bool exibindoHistoricoDescartados = false;
    private int diasAlerta = 7;
    private int diasHistorico = 30;
    private AppSettingsModel? _settings;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.GetSettingsAsync();
        if (_settings != null)
        {
            diasAlerta = _settings.DiasAlertaVencimento;
            diasHistorico = _settings.DiasHistoricoDescartados;
        }
    }

    private void ToggleAviso()
    {
        exibindoAvisoVencimento = !exibindoAvisoVencimento;
        if (exibindoAvisoVencimento) exibindoHistoricoDescartados = false;
    }

    private void ToggleHistorico()
    {
        exibindoHistoricoDescartados = !exibindoHistoricoDescartados;
        if (exibindoHistoricoDescartados) exibindoAvisoVencimento = false;
    }

    private async Task SalvarOpcoes()
    {
        int auxDiasAlerta = _settings.DiasAlertaVencimento;
        int auxDiasHistorico = _settings.DiasHistoricoDescartados;

        try
        {
            if (_settings != null)
            {
                _settings.DiasAlertaVencimento = diasAlerta;
                _settings.DiasHistoricoDescartados = diasHistorico;
                await SettingsService.SaveSettingsAsync(_settings);
            }
            await OnFechar.InvokeAsync();
        }
        catch (Exception ex)
        {
            _settings.DiasAlertaVencimento = auxDiasAlerta;
            _settings.DiasHistoricoDescartados = auxDiasHistorico;
            mensagemErro = $"Erro ao salvar: {ex.Message}";
        }
    }
}

<style>
    .alerta-sub {
        font-size: 13px !important;
        color: #bbb !important;
        margin-top: 6px !important;
        margin-bottom: 6px !important;
    }

    .modal-overlay {
        position: fixed !important;
        inset: 0 !important;
        background: rgba(0,0,0,0.6) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 20px !important;
        z-index: 2000 !important;
    }

    .opcoes-card {
        background: #1e1e1e !important;
        color: #fff !important;
        padding: 20px !important;
        border-radius: 8px !important;
        width: 100% !important;
        max-width: 320px !important;
        text-align: left !important;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5) !important;
    }

        .opcoes-card h3 {
            margin-top: 0 !important;
            border-bottom: 1px solid #444 !important;
            padding-bottom: 10px !important;
            font-size: 18px !important;
            margin-bottom: 12px !important;
            color: #ffc107 !important;
        }

    .menu-btn {
        width: 100% !important;
        text-align: left !important;
        background: none !important;
        border: none !important;
        color: #fff !important;
        padding: 10px 0 !important;
        font-size: 13px !important;
        cursor: pointer !important;
        display: flex !important;
        align-items: center !important;
        gap: 12px !important;
    }

    .btn-icon-claro {
        flex-shrink: 0 !important;
        color: #d1d1d1 !important;
    }

    .input-inline {
        margin-top: 4px !important;
        margin-bottom: 8px !important;
    }

    .form-control-input-opcoes {
        width: 100% !important;
        padding: 8px !important;
        border-radius: 4px !important;
        background: #2a2a2a !important;
        color: #ffffff !important;
        font-size: 14px !important;
        box-sizing: border-box !important;
        border: 1px solid #555 !important;
    }

        .form-control-input-opcoes:focus {
            outline: none !important;
            border-color: #1976d2 !important;
        }

    .modal-actions-opcoes {
        display: flex !important;
        justify-content: space-between !important;
        gap: 10px !important;
        margin-top: 15px !important;
    }

    .btn-opcoes {
        flex: 1 !important;
        padding: 8px 12px !important;
        border-radius: 4px !important;
        font-weight: bold !important;
        cursor: pointer !important;
        border: none !important;
        font-size: 13px !important;
        text-align: center !important;
    }

    .btn-primary-opcoes {
        background: #1976d2 !important;
        color: #fff !important;
    }

        .btn-primary-opcoes:hover {
            background: #1565c0 !important;
        }

    .btn-secondary-opcoes {
        background: #e0e0e0 !important;
        color: #333 !important;
    }

        .btn-secondary-opcoes:hover {
            background: #d0d0d0 !important;
        }

    .alert-error {
        background-color: #f8d7da !important;
        color: #842029 !important;
        border: 1px solid #f5c2c7 !important;
        padding: 6px 10px !important;
        border-radius: 4px !important;
        font-size: 12px !important;
        margin-bottom: 10px !important;
    }
</style>