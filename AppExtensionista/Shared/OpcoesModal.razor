@using AppExtensionista.Models
@using AppExtensionista.Services
@inject NavigationManager Navigation
@inject ISettingsService SettingsService

<div class="modal-overlay">
    <div class="modal-card opcoes-card">
        <h3>Opções do Dispositivo</h3>

        <button class="menu-btn" @onclick="ToggleAviso">
            <svg class="btn-icon-claro" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
                <circle cx="8" cy="14" r="1" fill="currentColor"></circle>
                <circle cx="12" cy="14" r="1" fill="currentColor"></circle>
                <circle cx="16" cy="14" r="1" fill="currentColor"></circle>
            </svg>
            <span>Alterar número de dias de aviso de vencimento</span>
        </button>

        @if (exibindoAvisoVencimento)
        {
            <p class="alerta-sub">Altera quantos dias antes do vencimento o alerta será exibido</p>

            <div class="input-inline">
                <input type="number" class="form-control-input-opcoes" @bind="diasAlerta" min="1" />
            </div>
        }

        <div class="modal-actions-opcoes">
            <button class="btn-opcoes btn-primary-opcoes" @onclick="SalvarOpcoes">Salvar Opções</button>
            <button class="btn-opcoes btn-secondary-opcoes" @onclick="OnFechar">Voltar</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnFechar { get; set; }

    private bool exibindoAvisoVencimento = false;
    private int diasAlerta = 7;
    private AppSettingsModel? _settings;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.GetSettingsAsync();
        if (_settings != null)
        {
            diasAlerta = _settings.DiasAlertaVencimento;
        }
    }

    private void ToggleAviso()
    {
        exibindoAvisoVencimento = !exibindoAvisoVencimento;
    }

    private async Task SalvarOpcoes()
    {
        if (_settings != null)
        {
            _settings.DiasAlertaVencimento = diasAlerta;
            await SettingsService.SaveSettingsAsync(_settings);
        }
        exibindoAvisoVencimento = false;
        await OnFechar.InvokeAsync();
    }
}

