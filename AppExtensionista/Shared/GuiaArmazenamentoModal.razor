@using AppExtensionista.ViewModels
@using AppExtensionista.Services
@inject IGuiaArmazenamentoService GuiaArmazenamentoService

@if (visivel)
{
    <div class="guia-modal-overlay">
        <div class="guia-modal-card">
            <h3>Guia de Armazenamento</h3>
            <p class="guia-sub">@(isEdicao ? "Visualize" : "Cadastre") as orientações de armazenamento para este alimento. Você pode editar!</p>

            @if (!string.IsNullOrEmpty(mensagemErro))
            {
                <div class="guia-alert-error">@mensagemErro</div>
            }

            <div class="guia-form-group">
                <label>Título da Guia:</label>
                <input type="text" class="guia-form-control" placeholder="Como armazenar Arroz..." @bind="formModel.Titulo" />
            </div>

            <div class="guia-form-group">
                <label>Instruções Detalhadas:</label>
                <textarea class="guia-form-control" rows="4" placeholder="Informe como conservar o alimento corretamente..." @bind="formModel.Descricao"></textarea>
            </div>

            <div class="guia-modal-actions">
                <button class="guia-btn guia-btn-primary" @onclick="SalvarGuia" disabled="@salvando">
                    @(salvando ? "Salvando..." : "Salvar Guia")
                </button>
                <button class="guia-btn guia-btn-secondary" @onclick="FecharModal">@(salvando ? "Ignorar" : "Sair")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnGuiaSalva { get; set; }

    private bool visivel = false;
    private bool isEdicao = false;
    private bool salvando = false;
    private string mensagemErro = "";
    private GuiaArmazenamentoFormViewModel formModel = new();
    private int _idAlimentoAtual;

    public async Task AbrirModalParaAlimento(int idAlimento, string nomeAlimento)
    {
        _idAlimentoAtual = idAlimento;
        mensagemErro = "";
        salvando = false;

        var guiaExistente = await GuiaArmazenamentoService.ObterPorAlimentoIdAsync(idAlimento);

        if (guiaExistente != null)
        {
            isEdicao = true;
            formModel = new GuiaArmazenamentoFormViewModel
            {
                IdGuiaArmazenamento = guiaExistente.IdGuiaArmazenamento,
                IdAlimento = idAlimento,
                Titulo = guiaExistente.Titulo,
                Descricao = guiaExistente.Descricao
            };
        }
        else
        {
            isEdicao = false;
            formModel = new GuiaArmazenamentoFormViewModel
            {
                IdAlimento = idAlimento,
                Titulo = "Como armazenar " + nomeAlimento,
                Descricao = ""
            };
        }

        visivel = true;
        StateHasChanged();
    }

    private async Task SalvarGuia()
    {
        if (string.IsNullOrWhiteSpace(formModel.Titulo) || string.IsNullOrWhiteSpace(formModel.Descricao))
        {
            mensagemErro = "Preencha o título e a descrição da guia.";
            return;
        }

        salvando = true;
        try
        {
            await GuiaArmazenamentoService.SalvarOuAtualizarGuiaAsync(formModel);
            visivel = false;
            await OnGuiaSalva.InvokeAsync();
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao salvar guia: {ex.Message}";
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task FecharModal()
    {
        visivel = false;
        await OnGuiaSalva.InvokeAsync();
    }
}

