@using AppExtensionista.ViewModels
@using AppExtensionista.Services
@inject IEstoqueService EstoqueService

@if (visivel && viewModel != null && viewModel.ExibirPopUp)
{
    <div class="modal-overlay">
        <div class="alerta-card">

            <div class="alerta-header">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ff4d4d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <h3>Atenção! Alimentos Próximos do Vencimento</h3>
            </div>

            <p class="alerta-sub">Os seguintes venceram ou vão vencer em até @viewModel.DiasConfigurados dias:</p>

            <div class="tabela-container">
                <table class="tabela-alerta">
                    <thead>
                        <tr>
                            <th>Alimento</th>
                            <th>Qtd</th>
                            <th>Validade</th>
                            <th>Situação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in viewModel.ItensAlerta)
                        {
                            var classeVencido = item.IsVencido ? "text-danger fw-bold" : "";
                            <tr class="@classeVencido">
                                <td>@item.NomeAlimento (@item.Marca)</td>
                                <td>@item.Quantidade @item.UnidadeMedidaSigla</td>
                                <td>@item.DataValidade.ToString("dd/MM/yy")</td>
                                <td>
                                    @if (item.IsVencido)
                                    {
                                        var diasVencido = Math.Abs(item.DiasAteVencimento);
                                        <span>Venceu há @diasVencido @(diasVencido == 1 ? "dia" : "dias")</span>
                                    }
                                    else if (item.DiasAteVencimento == 0)
                                    {
                                        <span>Vence hoje!</span>
                                    }
                                    else if (item.DiasAteVencimento == 1)
                                    {
                                        <span>Vence amanhã</span>
                                    }
                                    else
                                    {
                                        <span>Vence em @item.DiasAteVencimento dias</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="modal-actions align-right">
                <button class="btn btn-dark" @onclick="FecharModal">Entendido</button>
            </div>
        </div>
    </div>
}

@code {
    private AlertaVencimentoPopUpViewModel viewModel = new();
    private bool visivel = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarEExibirAutomatico();
    }

    public async Task CarregarEExibirAutomatico()
    {
        viewModel = await EstoqueService.ObterAlertasVencimentoAsync();
        // Abre sozinho ao carregar a página se houver alimentos críticos
        if (viewModel.ExibirPopUp)
        {
            visivel = true;
            StateHasChanged();
        }
    }

    // Método público para ser acionado externamente
    public async Task AbrirModalManual()
    {
        viewModel = await EstoqueService.ObterAlertasVencimentoAsync();
        visivel = true;
        StateHasChanged();
    }

    private void FecharModal()
    {
        visivel = false;
    }
}

<style>
    .modal-overlay {
        position: fixed !important;
        inset: 0 !important;
        background: rgba(0,0,0,0.7) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 20px !important;
        z-index: 3000 !important;
    }

    .alerta-card {
        background: #1e1e1e !important;
        color: #fff !important;
        padding: 24px !important;
        border-radius: 8px !important;
        width: 100% !important;
        max-width: 520px !important;
        box-shadow: 0 4px 20px rgba(0,0,0,0.6) !important;
    }

    .alerta-header {
        display: flex !important;
        align-items: center !important;
        gap: 12px !important;
    }

        .alerta-header h3 {
            margin: 0 !important;
