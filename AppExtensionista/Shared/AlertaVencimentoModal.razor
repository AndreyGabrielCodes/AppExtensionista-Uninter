        }

    .alerta-sub {
        font-size: 14px !important;
        color: #ccc !important;
        margin-bottom: 16px !important;
        padding-bottom: 8px !important;
        border-bottom: 1px solid #444 !important;
    }

    .tabela-container {
        max-height: 200px !important;
        overflow-y: auto !important;
        margin-bottom: 16px !important;
    }

    .tabela-alerta {
        width: 100% !important;
        font-size: 13px !important;
