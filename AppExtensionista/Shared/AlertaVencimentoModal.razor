@using AppExtensionista.ViewModels
@using AppExtensionista.Services
@inject IEstoqueService EstoqueService

@if (viewModel != null && viewModel.ExibirPopUp)
{
    <div class="modal-overlay">
        <div class="modal-card alerta-card">

            <div class="alerta-header">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ff4d4d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <h3>Atenção: Alimentos Próximos ao Vencimento</h3>
                
            </div>

            <span class="alerta-line"></span>

            <p class="alerta-sub">Os seguintes itens venceram ou vão vencer em até @viewModel.DiasConfigurados dias:</p>

            <div class="tabela-container">
                <table class="tabela-alerta">
                    <thead>
                        <tr>
                            <th>Alimento</th>
                            <th>Qtd</th>
                            <th>Validade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in viewModel.ItensAlerta)
                        {
                            var classeVencido = item.IsVencido ? "text-danger fw-bold" : "";
                            <tr class="@classeVencido">
                                <td>@item.NomeAlimento (@item.Marca)</td>
                                <td>@item.Quantidade @item.UnidadeMedidaSigla</td>
                                <td>@item.DataValidade.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="modal-actions align-right">
                <button class="btn btn-dark" @onclick="FecharModal">Entendido</button>
            </div>
        </div>
    </div>
}

@code {
    private AlertaVencimentoPopUpViewModel viewModel = new();

    protected override async Task OnInitializedAsync()
    {
        viewModel = await EstoqueService.ObterAlertasVencimentoAsync();
    }

    private void FecharModal()
    {
        viewModel.ItensAlerta.Clear();
    }
}

<style>
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 3000;
    }

    .alerta-card {
        background: #1e1e1e;
        color: #fff;
        padding: 24px;
        border-radius: 8px;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.6);
    }

    .alerta-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 14px;
        margin-bottom: 14px;
    }

        .alerta-header h3 {
            margin: 0;
            font-size: 16px;
            color: #ff4d4d;
            line-height: 1.2;
        }

    .alerta-line {
        border-bottom: 1px solid #444;
    }

    .alerta-sub {
        font-size: 13px;
        color: #ccc;
        margin-bottom: 16px;
    }

    .tabela-container {
        max-height: 200px;
        overflow-y: auto;
        margin-bottom: 16px;
    }

    .tabela-alerta {
        width: 100%;
        font-size: 13px;
        border-collapse: collapse;
        text-align: left;
    }

        .tabela-alerta th {
            color: #aaa;
            font-weight: 600;
            padding-bottom: 8px;
            border-bottom: none !important;
        }

        .tabela-alerta td {
            padding: 8px 4px;
            border-bottom: 1px solid #2a2a2a;
        }

    .text-danger {
        color: #ff6b6b !important;
    }

    .fw-bold {
        font-weight: bold;
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
    }

    .btn {
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        border: none;
    }

    .btn-dark {
        background: #333;
        color: #fff;
        border: 1px solid #555;
    }

        .btn-dark:hover {
            background: #444;
        }
</style>